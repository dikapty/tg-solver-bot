# === Обязательные ===
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Провайдер ИИ ===
# gemini — Google Gemini, бесплатный тариф (https://aistudio.google.com/apikey)
# anthropic — Claude, платный (https://console.anthropic.com/settings/keys)
PROVIDER=gemini
# Бесплатный ключ Google Gemini
GEMINI_API_KEY=
# Ключ Anthropic (нужен только при PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# === Модель ===
# Пусто — модель по умолчанию для провайдера (gemini-3.6-flash или claude-sonnet-5)
MODEL_NAME=

# === Лимиты и доступ ===
# Сколько запросов к ИИ в сутки разрешено одному пользователю
DAILY_LIMIT=20
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=111111111,222222222

# === База данных ===
# Путь к файлу SQLite (в Docker смонтирован в /app/data)
DB_PATH=data/bot.db

# === Режим запуска ===
# false — long polling (проще всего), true — webhook
USE_WEBHOOK=false
# Полный URL webhook (https обязателен), например https://bot.example.com/webhook
WEBHOOK_URL=
# Порт, который слушает aiohttp-сервер webhook
WEBHOOK_PORT=8080
# Секретный заголовок Telegram для проверки запросов webhook (придумайте строку)
WEBHOOK_SECRET=

# === Health-сервер (для бесплатного хостинга) ===
# Порт мини-HTTP-сервера «живости» для HuggingFace Space и подобных (0 — выключен)
HEALTH_PORT=0

# === Прокси для Telegram API ===
# Если api.telegram.org заблокирован провайдером, укажите прокси вашего VPN:
# socks5://127.0.0.1:1080 или http://127.0.0.1:8118 (пусто — без прокси)
TELEGRAM_PROXY=
